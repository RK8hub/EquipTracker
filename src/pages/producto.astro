---
import { Image } from "astro:assets";
import BaseLayout from "../layouts/BaseLayout.astro";
import CtaBand from "../components/CtaBand.astro";
import fichaEquipo from "../assets/captura-ficha-equipo.png";
import asignaciones from "../assets/captura-asignaciones.png";
import incidencias from "../assets/captura-incidencias.png";

const glosario = [
    [
        "Operador",
        "Persona de tu organización que recibe o usa un equipo. No es lo mismo que un usuario con acceso.",
    ],
    [
        "Asignación activa",
        "Relación vigente entre un operador y un equipo. Un equipo no puede tener dos a la vez.",
    ],
    [
        "Incidencia",
        "Problema registrado sobre un equipo. Al cerrarse pasa al historial como instantánea inmutable.",
    ],
];
---

<BaseLayout
    title="Producto — EquipTracker"
    description="Funciones de EquipTracker: inventario de equipos, operadores y asignaciones, incidencias, roles, exportación a CSV, API y cliente de escritorio."
>
    <section class="page-header">
        <div class="wrap">
            <p class="eyebrow">Producto</p>
            <h1 class="mt-3 max-w-3xl text-[clamp(2rem,3.6vw,3rem)] leading-tight tracking-[-0.02em]">
                Qué tienes, quién lo usa y qué le pasa.
            </h1>
            <p class="lede mt-4 max-w-2xl">
                Inventario, asignaciones e incidencias en la misma aplicación,
                con un tablero para ver el estado general y una ficha por
                equipo.
            </p>
        </div>
    </section>

    <section id="equipos" class="section scroll-mt-20">
        <div class="wrap grid items-center gap-10 lg:grid-cols-2 lg:gap-16">
            <div class="section-head">
                <p class="eyebrow">Equipos</p>
                <h2 class="mt-2">La ficha completa de cada equipo.</h2>
                <p>
                    Número de serie, marca y modelo, CPU, RAM, almacenamiento y
                    gráficos. Los números de serie se normalizan a mayúsculas al
                    guardar.
                </p>
                <ul class="mt-5 space-y-2 text-sm leading-relaxed text-muted-foreground">
                    <li class="flex gap-2">
                        <span aria-hidden="true" class="text-brand">
                            ✓
                        </span>{" "}
                        Alta y edición desde el cliente de escritorio.
                    </li>
                    <li class="flex gap-2">
                        <span aria-hidden="true" class="text-brand">
                            ✓
                        </span>{" "}
                        Consulta y filtrado desde la tabla de equipos.
                    </li>
                    <li class="flex gap-2">
                        <span aria-hidden="true" class="text-brand">
                            ✓
                        </span>{" "}
                        Exportación a CSV según el plan.
                    </li>
                </ul>
            </div>
            <Image
                src={fichaEquipo}
                alt="Ficha detallada de un equipo con sus especificaciones"
                width={1440}
                height={900}
                format="webp"
                loading="lazy"
                class="capture"
            />
        </div>
    </section>

    <section
        id="asignaciones"
        class="section scroll-mt-20 border-y border-border bg-page"
    >
        <div class="wrap grid items-center gap-10 lg:grid-cols-2 lg:gap-16">
            <Image
                src={asignaciones}
                alt="Listado de asignaciones de equipos a operadores"
                width={1440}
                height={900}
                format="webp"
                loading="lazy"
                class="capture lg:order-1"
            />
            <div class="section-head lg:order-2">
                <p class="eyebrow">Asignaciones</p>
                <h2 class="mt-2">El operador siempre queda identificado.</h2>
                <p>
                    Una asignación une a un operador con un equipo y guarda la
                    fecha de entrega. Al devolverlo, la asignación se cierra y
                    pasa al historial como instantánea inmutable. Un equipo no
                    puede tener dos asignaciones activas a la vez, pero un
                    operador puede tener varios equipos.
                </p>
                <p class="mt-3">
                    Los operadores se gestionan con nombre, departamento y
                    cargo, y no se eliminan mientras tengan asignaciones o
                    incidencias asociadas.
                </p>
            </div>
        </div>
    </section>

    <section id="incidencias" class="section scroll-mt-20">
        <div class="wrap grid items-center gap-10 lg:grid-cols-2 lg:gap-16">
            <div class="section-head">
                <p class="eyebrow">Incidencias</p>
                <h2 class="mt-2">Un problema no se pierde entre mensajes.</h2>
                <p>
                    Se reportan desde la ficha del equipo y se cierran con una
                    resolución. Normalmente reporta el operador asignado,
                    también puede hacerlo otra persona. Al cerrarse, la fila
                    sale de la tabla activa y se guarda como instantánea
                    inmutable en el historial; mientras está activa, sí se puede
                    modificar. En Nube el cupo se reparte a mitad entre
                    incidencias y asignaciones (500+500, 1.500+1.500 o
                    3.000+3.000); en local no hay límite.
                </p>
                <ul class="mt-5 space-y-2 text-sm leading-relaxed text-muted-foreground">
                    <li class="flex gap-2">
                        <span aria-hidden="true" class="text-brand">
                            ✓
                        </span>{" "}
                        Alta desde la ficha del equipo.
                    </li>
                    <li class="flex gap-2">
                        <span aria-hidden="true" class="text-brand">
                            ✓
                        </span>{" "}
                        Operador autocompletado, sustituible si reporta otra
                        persona.
                    </li>
                    <li class="flex gap-2">
                        <span aria-hidden="true" class="text-brand">
                            ✓
                        </span>{" "}
                        Cierre obligatorio con resolución.
                    </li>
                    <li class="flex gap-2">
                        <span aria-hidden="true" class="text-brand">
                            ✓
                        </span>{" "}
                        Consulta del estado en el tablero.
                    </li>
                </ul>
            </div>
            <Image
                src={incidencias}
                alt="Listado de incidencias registradas en EquipTracker"
                width={1440}
                height={900}
                format="webp"
                loading="lazy"
                class="capture"
            />
        </div>
    </section>

    <section class="section-compact border-y border-border bg-page">
        <div class="wrap">
            <div class="section-head">
                <p class="eyebrow">Glosario</p>
                <h2 class="mt-2">Tres términos que conviene definir.</h2>
            </div>
            <dl class="mt-6 grid gap-4 md:grid-cols-3">
                {glosario.map(([termino, definicion]) => (
                    <div class="rounded-lg border border-border bg-card p-5">
                        <dt class="font-semibold text-foreground">{termino}</dt>
                        <dd class="mt-2 text-sm leading-relaxed text-muted-foreground">
                            {definicion}
                        </dd>
                    </div>
                ))}
            </dl>
        </div>
    </section>

    <section id="migracion" class="section scroll-mt-20">
        <div class="wrap">
            <div class="section-head">
                <p class="eyebrow">Migración desde Excel</p>
                <h2 class="mt-2">Trae tus datos sin empezar de cero.</h2>
                <p>
                    La carga CSV es un servicio asistido por RK8, incluido en
                    las ofertas Equipos e Integral: partimos de tu hoja de
                    cálculo y dejamos el registro listo para usar.
                </p>
                <p class="mt-3 text-sm">
                    No es una función automática de descubrimiento de red.
                </p>
            </div>
        </div>
    </section>

    <section
        id="acceso"
        class="section-compact scroll-mt-20 border-t border-border bg-page"
    >
        <div class="wrap">
            <div class="section-head">
                <p class="eyebrow">Acceso y despliegue</p>
                <h2 class="mt-2">Detalles para el equipo técnico.</h2>
                <p>
                    La arquitectura es la misma en las dos modalidades; lo que
                    cambia es quién administra la infraestructura y quién puede
                    llegar a la API y a los datos.
                </p>
            </div>
            <div class="mt-6 grid gap-4 md:grid-cols-2">
                <div class="rounded-lg border border-border bg-card p-5">
                    <h3 class="font-semibold">Usuarios y roles</h3>
                    <p class="mt-2 text-sm leading-relaxed text-muted-foreground">
                        Autenticación JWT y dos roles: administrador y staff;
                        en Nube Inicial solo existe un administrador. Los
                        permisos disponibles dependen del plan; el alta de
                        usuarios se controla desde la aplicación.
                    </p>
                </div>
                <div class="rounded-lg border border-border bg-card p-5">
                    <h3 class="font-semibold">Cliente de escritorio</h3>
                    <p class="mt-2 text-sm leading-relaxed text-muted-foreground">
                        Aplicación Tauri y React para Windows, Linux y macOS. Es
                        la vía de conexión en todas las ofertas Nube.
                    </p>
                </div>
                <div class="rounded-lg border border-border bg-card p-5">
                    <h3 class="font-semibold">API REST</h3>
                    <p class="mt-2 text-sm leading-relaxed text-muted-foreground">
                        Servicio FastAPI con las reglas de negocio. En Nube, el
                        acceso para integraciones se reserva al plan Integral y
                        usa JWT sobre TLS; la activación es por código y la
                        licencia local se firma con Ed25519. En instalación
                        local está disponible en todas las ofertas, sin límite
                        de llamadas pero con autenticación a cargo del cliente
                        (RK8 puede proporcionarla en Local Integral).
                    </p>
                </div>
                <div class="rounded-lg border border-border bg-card p-5">
                    <h3 class="font-semibold">Base de datos</h3>
                    <p class="mt-2 text-sm leading-relaxed text-muted-foreground">
                        PostgreSQL 16 en contenedor. En Nube, el acceso a los
                        datos se realiza siempre desde el cliente; en
                        instalación local, la base de datos se despliega con
                        Docker y un proxy Nginx en tus servidores.
                    </p>
                </div>
            </div>
            <details class="group mt-6 rounded-lg border border-border bg-card p-5">
                <summary class="flex cursor-pointer list-none items-center justify-between gap-4 font-semibold marker:content-none">
                    Requisitos y condiciones de la instalación local{" "}
                    <span
                        aria-hidden="true"
                        class="text-xl font-normal text-brand transition-transform group-open:rotate-45"
                    >
                        +
                    </span>
                </summary>
                <p class="mt-4 text-sm leading-relaxed text-muted-foreground">
                    Aportas el servidor y su administración; la instalación y la
                    licencia de uso se cotizan aparte, sin límite de equipos ni
                    operadores. Requisitos mínimos orientativos: Windows o Linux,
                    4 GiB de RAM libre, 20 GB de almacenamiento y 2 vCPU. Se
                    confirman por correo en la cotización.
                </p>
            </details>
        </div>
    </section>

    <CtaBand
        titulo="Comprueba los flujos en la demo."
        texto="Registra un equipo, asígnalo y abre una incidencia sin instalar nada."
        href="/demo"
        label="Probar la demo"
        secundario={{ href: "/seguridad", label: "Seguridad y datos" }}
    />
</BaseLayout>
