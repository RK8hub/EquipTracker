---
const path = Astro.url.pathname.replace(/\/$/, "") || "/";
const nav = [
    { href: "/", label: "Inicio" },
    { href: "/producto", label: "Producto" },
    { href: "/precios", label: "Precios" },
    { href: "/demo", label: "Demo" },
    { href: "/soporte", label: "Soporte" },
    { href: "/contacto", label: "Contacto" },
];
---

<header class="sticky top-0 z-40 border-b border-border bg-background/95 backdrop-blur">
    <div class="wrap flex h-14 items-center justify-between gap-3 md:h-16">
        <a href="/" class="flex shrink-0 items-center">
            <img
                src="/logo-con-texto-dark.svg"
                alt="EquipTracker, ir al inicio"
                width="220"
                height="28"
                class="h-7 w-auto dark:hidden"
            />
            <img
                src="/logo-con-texto.svg"
                alt="EquipTracker, ir al inicio"
                width="220"
                height="28"
                class="hidden h-7 w-auto dark:block"
            />
        </a>

        <nav
            aria-label="Navegación principal"
            class="hidden items-center gap-5 md:flex lg:gap-7"
        >
            {nav.map((item) => (
                <a
                    href={item.href}
                    aria-current={path === item.href ? "page" : undefined}
                    class:list={[
                        "text-sm font-medium transition-colors",
                        path === item.href
                            ? "text-brand"
                            : "text-muted-foreground hover:text-foreground",
                    ]}
                >
                    {item.label}
                </a>
            ))}
        </nav>

        <div class="flex items-center gap-2">
            <button
                id="theme-toggle"
                type="button"
                aria-pressed="false"
                aria-label="Cambiar tema"
                class="inline-flex h-10 w-10 items-center justify-center rounded-lg border border-border bg-card text-foreground transition hover:border-brand hover:text-brand active:translate-y-px"
            >
                <svg
                    aria-hidden="true"
                    viewBox="0 0 20 20"
                    class="h-5 w-5 dark:hidden"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="1.6"
                >
                    <path
                        d="M16.5 12.6A7 7 0 0 1 7.4 3.5a7 7 0 1 0 9.1 9.1Z"
                        stroke-linecap="round"
                        stroke-linejoin="round"
                    />
                </svg>
                <svg
                    aria-hidden="true"
                    viewBox="0 0 20 20"
                    class="hidden h-5 w-5 dark:block"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="1.6"
                >
                    <circle cx="10" cy="10" r="3.5" />
                    <path
                        d="M10 2v2m0 12v2M2 10h2m12 0h2M4.3 4.3l1.4 1.4m8.6 8.6 1.4 1.4m0-11.4-1.4 1.4M5.7 14.3l-1.4 1.4"
                        stroke-linecap="round"
                    />
                </svg>
            </button>
            <details class="relative md:hidden">
                <summary class="inline-flex h-10 cursor-pointer list-none items-center rounded-lg border border-border bg-card px-3 text-sm font-medium marker:content-none">
                    Menú
                </summary>
                <nav
                    aria-label="Navegación móvil"
                    class="absolute right-0 top-12 z-50 w-48 rounded-lg border border-border bg-card p-2 shadow-lg"
                >
                    {nav.map((item) => (
                        <a
                            href={item.href}
                            aria-current={
                                path === item.href ? "page" : undefined
                            }
                            class:list={[
                                "block rounded-md px-3 py-2 text-sm",
                                path === item.href
                                    ? "bg-brand/10 text-brand"
                                    : "text-foreground hover:bg-page",
                            ]}
                        >
                            {item.label}
                        </a>
                    ))}
                </nav>
            </details>
        </div>
    </div>
</header>
